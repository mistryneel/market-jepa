# Copy to .env (git-ignored) and fill in locally. NEVER commit real values.
# The harness reads environment variables only. Load this file into the environment with:
#   uv run --env-file .env mjepa doctor
# docs/harness/HUMAN_TODO.md explains how to obtain each credential.
# Empty values count as unset.

# Where all data lives. Must be outside the repository. Default: ~/data/market-jepa
MJ_DATA_DIR=
# Optional: DEBUG | INFO | WARNING | ERROR (default INFO); text | json (default text)
MJ_LOG_LEVEL=
MJ_LOG_FORMAT=

# Massive (formerly Polygon.io): REST API key and flat-file (S3-compatible) credentials.
MASSIVE_API_KEY=
MASSIVE_S3_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=

# FRED / ALFRED API key (free account at fred.stlouisfed.org).
FRED_API_KEY=

# SEC EDGAR fair-access User-Agent, e.g. "Jane Doe Research jane@example.org".
SEC_USER_AGENT=

# Hugging Face access token (optional for public datasets; raises rate limits).
HF_TOKEN=
